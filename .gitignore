# Large UAV research data stays on this machine or in Google Drive.
# dataset/ is about 3.1 GB and includes the original ZIP and ULog files.
dataset/*
!dataset/UAVAttackData/
dataset/UAVAttackData/*
!dataset/UAVAttackData/explore_dataset.py

# Extra protection if an archive or flight log is placed outside dataset/
*.zip
*.ulg
*.ulog

